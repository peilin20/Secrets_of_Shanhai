  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameSetup
  runOnStart: 1
  playerCount: 3
  nextScene: Tutorial
  speciesOptions:
  - species: 3
    displayName: "\u4EBA\u7C7B"
    portrait: {fileID: 21300000, guid: bef7cb5cde2db7a49a36f969e11854bb, type: 3}
    description: "\u624B\u724C\u4E0A\u9650+1"
    descriptionEnglish: Hand limit +1
  - species: 1
    displayName: "\u4E5D\u5C3E"
    portrait: {fileID: 21300000, guid: 2b464b2adb0144c4abeb30414fdc07fd, type: 3}
    description: "\u5728\u793E\u4EA4\u4E2D\uFF0C\u5982\u679C\u5728\u597D\u611F\u5EA6\u4E3A1\u65F6\u4E0A\u573A\uFF0C\u672C\u8F6E\u5FC3\u6709\u7075\u7280\u52A0\u6210\u500D\u7387\u4E3A3"
    descriptionEnglish: "In a social encounter, if you go on stage while favor is 1, the \u5FC3\u6709\u7075\u7280 (Kindred Spirits) bonus multiplier is 3 this round"
  - species: 0
    displayName: "\u9955\u88D4"
    portrait: {fileID: 21300000, guid: 1e2f5bb894d541445aae84046758790c, type: 3}
    description: "\u4F60\u53EF\u4EE5\u541E\u566C\u4EFB\u610F\u9053\u5177\u724C\uFF0C\u5C06\u5176\u8F6C\u5316\u4E3Ax+1\u679A\u4EC5\u5728\u5F53\u524D\u4E8B\u4EF6\u751F\u6548\u7684\u4E34\u65F6token\uFF0C\u5C5E\u6027\u4E3A\u9053\u5177\u5BF9\u5E94\u5C5E\u6027\uFF0Cx\u4E3A\u8FD9\u56DE\u5408\u541E\u566C\u7684\u9053\u5177\u724C\u603B\u6570\u3002\u6BCF\u5F53\u4F60\u541E\u566C\u65F6\uFF0C\u6295\u63B7\u4E00\u679A1d6\uFF0C\u5982\u679C\u70B9\u6570\u5C0F\u4E8Ex\uFF0C\u4F60\u5C06\u4E0D\u53D7\u63A7\u5236\uFF0C\u541E\u566C\u8EAB\u4E0A\u9664\u6B66\u5668\u5916\u6240\u6709\u9053\u5177\u3002\u4EE5\u6B64\u65B9\u5F0F\u88AB\u541E\u566C\u7684\u9053\u5177\u724C\u4E5F\u5C06\u8F6C\u5316\u4E3A\u4E34\u65F6token\u3002"
    descriptionEnglish: 'You can devour any item card and turn it into x+1 temporary tokens of the item''s element that last only for the current event, where x is the number of item cards devoured this round. Each time you devour, roll 1d6: if the result is less than x, you lose control and devour every item you carry except weapons. Items devoured this way also turn into temporary tokens.'
  - species: 2
    displayName: "\u767D\u6CFD"
    portrait: {fileID: 21300000, guid: cbd21efaa39963e4cb633533b291b97d, type: 3}
    description: "\u65E0\u89C6\u804C\u4E1A\u9650\u5236\uFF0C\u53EF\u4EE5\u4F7F\u7528\u4E66\u5377\u7C7B\u6B66\u5668"
    descriptionEnglish: Ignores class restrictions; can use scroll weapons

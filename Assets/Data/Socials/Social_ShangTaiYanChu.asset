    reward: "\u4F60\u4EEC\u51B2\u4E0A\u620F\u53F0\u53C8\u5531\u53C8\u8DF3\uFF0C\u5438\u5F15\u4E86\u5927\u5BB6\u7684\u6CE8\u610F\u529B\u3002\u56E0\u4E3A\u6F14\u51FA\u592A\u8FC7\u8352\u5510\uFF0C\u5251\u62D4\u5F29\u5F20\u7684\u6C14\u6C1B\u88AB\u5E73\u606F\u4E86\u3002\u620F\u73ED\u73ED\u4E3B\u770B\u51FA\u4E86\u4F60\u4EEC\u7684\u6F14\u51FA\u5929\u8D4B\uFF0C\u548C\u4F60\u4EEC\u804A\u4E86\u5F88\u591A\u5173\u4E8E\u827A\u4EBA\u7684\u81EA\u6211\u4FEE\u517B\uFF0C\u8FD8\u70ED\u60C5\u5730\u5206\u4EAB\u65E7\u620F\u8C31\u7ED9\u4F60\u4EEC\u770B\uFF0C\u8BC1\u660E\u4ED6\u4EEC\u5E76\u975E\u6709\u610F\u4EB5\u6E0E\u96E8\u795E\u3002\u83B7\u5F971\u91D1token\uFF0C\u83B7\u5F971\u6728token\uFF0C\u83B7\u5F971\u6C34token\uFF0C\u83B7\u5F971\u706Btoken\uFF0C\u83B7\u5F971\u571Ftoken+\u79D8\u95FB\u5361\uFF08\u96E8\u795E\uFF09"

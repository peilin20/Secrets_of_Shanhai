  title: "\u4E95\u53E3\u4E4B\u4E71"
  image: {fileID: 0}
  description: "\u4F60\u4EEC\u6CE8\u610F\u5230\u4E00\u53E3\u8001\u4E95\u8FB9\u7684\u6DF7\u4E71\u3002\n\n\u6751\u6C11\u4EEC\u60F3\u8BD5\u8BD5\u8FD8\u80FD\u4E0D\u80FD\u4ECE\u4E95\u91CC\u6253\u51FA\u4E00\u70B9\u6C34\u3002\u4ED6\u4EEC\u521A\u4E00\u653E\u4E0B\u6C34\u6876\uFF0C\u4E95\u5E95\u5C31\u4F20\u6765\u5A74\u513F\u557C\u54ED\u822C\u7684\u5C16\u53EB\uFF1A\u4E00\u6761\u5DE8\u5927\u7684\u4EBA\u9762\u9C7C\u8EAB\u7684\u8D64\u9C6C\u968F\u5373\u8DC3\u51FA\u4E95\u53E3\uFF0C\u75AF\u72C2\u653B\u51FB\u53D6\u6C34\u7684\u6751\u6C11\u3002\n\n\u8981\u5E2E\u52A9\u6751\u6C11\u89E3\u51B3\u6DF7\u4E71\u5417\uFF1F"
  options:
  - label: "\u6218\u6597:"
    text: "\u6253\u8D25\u8D64\u9C6C"
    kind: 0
    buttonName: "\u6253\u8D25\u8D64\u9C6C"
    combat: {fileID: 11400000, guid: a53bf530db343104882608db3679ab43, type: 2}
    social: {fileID: 0}
    requiresSpecies: 0
    species: 0
    choiceText: 
    acceptButton: "\u7B54\u5E94"
    refuseButton: "\u62D2\u7EDD"
    acceptResult: 
  - label: "\u793E\u4EA4:"
    text: "\u4E0E\u6751\u6C11\u6C9F\u901A\uFF0C\u8BA9\u4ED6\u4EEC\u653E\u5F03\u53D6\u6C34"
    kind: 1
    buttonName: "\u4E0E\u6751\u6C11\u6C9F\u901A"
    combat: {fileID: 0}
    social: {fileID: 11400000, guid: bc43c2cd200e8e7499c9db24259c7076, type: 2}
    requiresSpecies: 0
    species: 0
    choiceText: 
    acceptButton: "\u7B54\u5E94"
    refuseButton: "\u62D2\u7EDD"
    acceptResult: 
  - label: "\u767D\u6CFD:"
    text: "\u5F53\u56E2\u961F\u4E2D\u6709\u767D\u6CFD\u73A9\u5BB6\uFF0C\u53EF\u4EE5\u5C1D\u8BD5\u4E0E\u8D64\u9C6C\u6C9F\u901A\uFF0C\u5316\u89E3\u7EB7\u4E89"
    kind: 3
    buttonName: "\u4E0E\u8D64\u9C6C\u6C9F\u901A"
    combat: {fileID: 0}
    social: {fileID: 0}
    requiresSpecies: 1
    species: 2
    choiceText: "\u4F60\u5F97\u77E5\uFF0C\u8FD9\u91CC\u662F\u8D64\u9C6C\u6700\u540E\u7684\u6816\u8EAB\u4E4B\u6240\u3002\u5B83\u56E0\u4E3A\u4F53\u578B\u592A\u5927\uFF0C\u65E0\u6CD5\u6CBF\u7740\u4E95\u5E95\u7684\u6C34\u9053\u79BB\u5F00\u3002\n\u8D64\u9C6C\u8BF7\u6C42\u4F60\u4EEC\u628A\u5B83\u9001\u5230\u66F4\u5927\u7684\u6C34\u57DF\uFF0C\u4F5C\u4E3A\u62A5\u916C\uFF0C\u5B83\u4F1A\u544A\u8BC9\u4F60\u4EEC\u4E00\u5904\u6C34\u5E95\u79D8\u5B9D\u7684\u6240\u5728\u5730\u3002\n\n\u643A\u5E26\u8D64\u9C6C\u9700\u89812\u80CC\u5305\u69FD\u4F4D\u3002\u5982\u679C\u4F60\u4EEC\u7B54\u5E94\u5E2E\u5FD9\uFF0C\u9700\u8981\u4E00\u76F4\u6301\u6709\u8D64\u9C6C\uFF0C\u76F4\u5230\u5B58\u5728\u6C34\u57DF\u7684\u4E8B\u4EF6\u724C\u51FA\u73B0\u3002\n\u5F53\u6210\u529F\u628A\u8D64\u9C6C\u653E\u5230\u65B0\u7684\u6C34\u57DF\u65F6\uFF0C\u83B7\u5F97\u79D8\u95FB\u724C\u201C\u85CF\u5B9D\u5730\u201D\n\n\u7B54\u5E94\u5E2E\u5FD9\uFF1A\u4FDD\u7559\u6B64\u724C\u4F5C\u4E3A\u8D64\u9C6C\u3002\n\u62D2\u7EDD\uFF1A\u8FD4\u56DE\u4E95\u53E3\u4E4B\u4E71\u4E8B\u4EF6\u724C\uFF0C\u4ECE\u6218\u6597\u548C\u793E\u4EA4\u4E2D\u4E8C\u9009\u4E00"
    acceptButton: "\u7B54\u5E94\u5E2E\u5FD9"
    refuseButton: "\u62D2\u7EDD"
    acceptResult: "\u4FDD\u7559\u6B64\u724C\u4F5C\u4E3A\u8D64\u9C6C\uFF0C\u53602\u80CC\u5305\u69FD\u4F4D\u3002"

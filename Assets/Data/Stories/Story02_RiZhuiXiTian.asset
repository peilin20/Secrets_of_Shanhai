  m_Name: Story02_RiZhuiXiTian
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  number: 2
  title: "\u65E5\u5760\u897F\u5929\uFF0C\u7126\u79BE\u6740\u6728"
  image: {fileID: 0}
  subtitle: "\u54B8\u6765\u6709\u5BA2"
  body: "\u4F60\u4EEC\u6839\u636E\u65E7\u8206\u56FE\uFF0C\u8D70\u4E86\u597D\u51E0\u4E2A\u65F6\u8FB0\u7684\u5C71\u8DEF\uFF0C\u8D8A\u8FC7\u51E0\u4E2A\u5C71\u5773\uFF0C\u524D\u65B9\u6E10\u6E10\u51FA\u73B0\u4E86\u5C4B\u820D\u3002\n\u6751\u5B50\u7684\u89C4\u6A21\u4E0D\u5927\uFF0C\u4F60\u4EEC\u51E0\u4E2A\u4EBA\u4E0D\u7EA6\u800C\u540C\u5730\u5BDF\u89C9\u5230\u4E86\u5F02\u6837\u3002\u539F\u672C\u5E94\u8BE5\u662F\u5C0F\u6EAA\u7684\u5730\u65B9\uFF0C\u6E20\u5E95\u53EA\u5269\u51E0\u9897\u5E72\u88C2\u7684\u77F3\u5934\uFF0C\u5230\u5904\u90FD\u662F\u4E00\u675F\u675F\u892A\u8272\u5E72\u71E5\u7684\u9999\u6599\u548C\u5E72\u8349\uFF0C\u51E0\u4E4E\u6CA1\u6709\u4E00\u4E2A\u70DF\u56F1\u6709\u708A\u70DF\u5439\u51FA\u3002\n\u5982\u679C\u65E7\u8206\u56FE\u8FD8\u6CA1\u6709\u5F7B\u5E95\u5931\u6548\uFF0C\u8FD9\u91CC\u5E94\u8BE5\u662F\u9955\u992E\u7684\u6751\u5E84\u3002\n<color=#808080>\u4E3B\u6301\u4EBA\u63CF\u8FF0\u9955\u992E\u7684\u5916\u5F62\u548C\u6751\u5E84\u7684\u60C5\u51B5\uFF1A\u7F8A\u8EAB\u4EBA\u9762\uFF0C\u4E0B\u80A2\u5B8C\u5168\u662F\u4E00\u526F\u7F8A\u817F\uFF0C\u819D\u8282\u53CD\u6298\uFF0C\u8E44\u9762\u5F00\u88C2\u3002\u6751\u5E84\u53CA\u5176\u5468\u56F4\u7684\u6CB3\u5E8A\u90FD\u663E\u793A\u51FA\u5B8C\u5168\u5E72\u6DB8\u7684\u6837\u5B50\uFF0C\u548C\u8206\u56FE\u4E0A\u8FE5\u5F02\u4E4B\u5904\u9887\u591A\u3002</color>\n\u4F60\u4EEC\u53D1\u73B0\u6751\u6C11\u4EEC\u5168\u90FD\u7528\u5E03\u6761\u7D27\u7D27\u7F20\u7740\u8170\u90E8\uFF0C\u795E\u60C5\u840E\u9761\u53C8\u5E26\u7740\u70B9\u9047\u89C1\u751F\u4EBA\u7684\u8BD5\u63A2\u4E0E\u7D27\u5F20\u3002\u4ED6\u4EEC\u4F3C\u4E4E\u603B\u5FCD\u4E0D\u4F4F\u770B\u4F60\u4EEC\u5E26\u7740\u7684\u53E3\u7CAE\uFF0C\u53C8\u5F88\u5FEB\u79FB\u5F00\u76EE\u5149\u3002\u56E0\u4E3A\u5929\u8272\u6E10\u665A\uFF0C\u4F60\u4EEC\u51B3\u5B9A\u627E\u4E2A\u843D\u811A\u5904\u3002\u4F46\u662F\u8FD9\u4E2A\u6751\u5E84\u7684\u5F02\u6837\u8BA9\u4F60\u4EEC\u51B3\u5B9A\u5148\u8C03\u67E5\u4E00\u4E0B\u53D1\u751F\u4E86\u4EC0\u4E48\u3002"
  nextStep: "\u4E0B\u4E00\u6B65\uFF1A\u9009\u62E9\u201C\u5728\u5468\u56F4\u8D70\u8D70\u201D\uFF0C\u62BD\u53D6x\u5F20\u4E8B\u4EF6\u724C\uFF1B\u6216\u662F\u9009\u62E9\u201C\u76F4\u63A5\u8BE2\u95EE\u6751\u6C11\u201D\uFF0C\u62BD\u53D6x\u5F20\u6751\u6C11\u724C\u3002\n\u6240\u6709\u5361\u724C\u90FD\u88AB\u89E3\u51B3\u540E\uFF0C\u7FFB\u5F00\u4E0B\u4E00\u5F20\u4E3B\u7EBF\u5361\u3002"
  eventCardsToDraw: 0
  fixedEvents:

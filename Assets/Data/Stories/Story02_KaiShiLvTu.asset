  title: "\u5F00\u59CB\u65C5\u9014"
  image: {fileID: 0}
  subtitle: "\u540C\u884C\u8005"
  body: "\u5408\u4F5C\u89E3\u51B3\u4E8B\u4EF6\u540E\uFF0C\u4F60\u4EEC\u5DF2\u7ECF\u9010\u6E10\u719F\u6089\u8D77\u6765\u3002\u4F5C\u4E3A\u5171\u540C\u8D1F\u8D23\u5404\u5730\u6D4B\u7ED8\u4E0E\u8BB0\u5F55\u7684\u5C0F\u961F\uFF0C\u4F60\u4EEC\u5F00\u59CB\u4E00\u8FB9\u6574\u7406\u8FD9\u6B21\u4E8B\u4EF6\u4E2D\u7684\u5730\u5F62\u4E0E\u751F\u6001\u8D44\u6599\uFF0C\u4E00\u8FB9\u804A\u8D77\u4E86\u5404\u81EA\u4E3A\u4EC0\u4E48\u52A0\u5165\u6D4B\u7ED8\u5C0F\u961F\u3002\n\n\u3010\u6240\u6709\u89D2\u8272\u9010\u4E2A\u4ECB\u7ECD\u81EA\u5DF1\u7684\u80CC\u666F\u3011\n\n\u6574\u7406\u5B8C\u8BB0\u5F55\u540E\uFF0C\u4F60\u4EEC\u7EE7\u7EED\u6309\u7167\u6D4B\u7ED8\u4EFB\u52A1\u524D\u5F80\u4E0B\u4E00\u4E2A\u5730\u533A\u2014\u2014<b>\u65ED\u65E5\u6751</b>\u3002"
  nextStep: "\u4E0B\u4E00\u6B65\uFF1A\u65ED\u65E5\u6751\u5C31\u5728\u4E0D\u8FDC\u5904\u3002\u62BD\u53D63\u5F20\u968F\u673A\u4E8B\u4EF6\u724C\uFF0C\u724C\u9762\u671D\u4E0B\uFF0C\u6D17\u724C\u5E76\u4F9D\u6B21\u586B\u5165\u5730\u56FE\u7248\u76841-3\u53F7\u4F4D\u7F6E\u3002\u4F9D\u6B21\u89E3\u51B3\u6240\u6709\u4E8B\u4EF6\u540E\uFF0C\u7FFB\u5F003\u53F7\u4E3B\u7EBF\u724C \u3010\u5F02\u5E38\u708E\u70ED\u7684\u6751\u5E84\u3011"
  eventCardsToDraw: 3
